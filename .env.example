# ============================================================
# Zero AI Note — Environment Variables ("bản đồ" duy nhất)
# Copy file này thành .env.local (dev) và nhập giá trị thật.
# Production: nhập trực tiếp vào Vercel Dashboard (Settings →
# Environment Variables). KHÔNG lưu giá trị thật ở máy local.
# ============================================================

# --- Database (Neon Postgres serverless) ---
# Lấy từ Neon Console → project → Dashboard → Connection string
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# --- Auth: JWT secret (bắt buộc, đổi thành chuỗi ngẫu nhiên dài ≥ 32 ký tự) ---
ZERO_JWT_SECRET="replace-with-a-long-random-string"

# --- Admin (email admin duy nhất — auto-assign role admin khi register) ---
ADMIN_EMAIL="nguyenchithang2804@gmail.com"

# --- Google OAuth (bắt buộc cho Google Sign-In) ---
# Tạo tại: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized JavaScript Origins: http://localhost:3000, https://zero-ai-note.vercel.app
# Authorized Redirect URIs: không cần (dùng Google Identity Services popup, không redirect)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Storage: Neon database (chính) + Cloudflare R2 (backup khi Neon đầy — quyết định 2026-08-17) ---
# R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="zero-ai-note"
# R2_PUBLIC_URL (tuỳ chọn): domain public custom nếu bật R2 Public Access
# R2_PUBLIC_URL="https://cdn.example.com"

# --- AI Providers (dùng cho pipeline Tuần 3-4: transcribe + structure) ---
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# OpenAI (tuỳ chọn, BYOK)
OPENAI_API_KEY=""

# --- Billing (tương lai, Tuần 10-11) ---
# ZEROINVOICE_API_KEY=""
# ZEROINVOICE_WEBHOOK_SECRET=""
