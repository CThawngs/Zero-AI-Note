# ============================================================
# Zero AI Note — Environment Variables
# Copy file này thành .env.local và điền giá trị thật.
# KHÔNG bao giờ commit .env.local lên GitHub.
# ============================================================

# --- Database (Neon Postgres) ---
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# --- Auth (JWT secret — đổi thành chuỗi ngẫu nhiên dài) ---
ZERO_JWT_SECRET="replace-with-a-long-random-string"

# --- Admin (email admin duy nhất — auto-assign role admin khi register) ---
ADMIN_EMAIL="nguyenchithang2804@gmail.com"

# --- Storage: Cloudflare R2 (storage chính — quyết định 2026-08-16) ---
# R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET="zero-ai-note"
# R2_PUBLIC_URL (tuỳ chọn): domain public custom nếu bật R2 Public Access
# R2_PUBLIC_URL="https://cdn.example.com"

# --- AI Providers (tuỳ chọn, dùng cho pipeline Tuần 3-4) ---
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""